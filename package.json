{
  "name": "shashank-futuristic-mern-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Futuristic MERN portfolio for Kuruba Shashank",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
